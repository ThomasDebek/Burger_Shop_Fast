<h2>Extras</h2>

<% if @extras.any? %>
  <% @extras.each do |extra| %>
    <div>
      <p>
        <%= extra.name %>
        -
        <%= extra.price %> PLN
      </p>

      <%= link_to "Edit",
                  edit_burger_extra_path(@burger, extra) %>

      <%= button_to "Remove",
                    burger_extra_path(@burger, extra),
                    method: :delete %>
    </div>
  <% end %>
<% else %>
  <p>No extras.</p>
<% end %>