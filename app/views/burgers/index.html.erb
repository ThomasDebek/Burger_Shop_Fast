<p style="color: green"><%= notice %></p>

<% content_for :title, "Burgers" %>

<h1>Burgers</h1>

<div id="burgers">
  <% @burgers.each do |burger| %>
    <%= render burger %>

    <p>
      <%= link_to "Show this burger", burger_path(burger) %>
    </p>

    <p>
      <%= link_to "Extras", burger_path(burger, anchor: "extras") %>
    </p>
  <% end %>
</div>

<%= link_to "New burger", new_burger_path %>