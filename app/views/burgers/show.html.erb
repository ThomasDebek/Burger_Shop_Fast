<h2 id="extras">Extras</h2>

<% if @extras.any? %>
  <% @extras.each do |extra| %>
    <div>
      <p>
        <strong><%= extra.name %></strong>
        —
        <%= extra.price %> PLN
      </p>

      <%= link_to "Edit ingredient",
                  edit_burger_extra_path(@burger, extra) %>

      <%= button_to "Remove ingredient",
                    burger_extra_path(@burger, extra),
                    method: :delete %>
    </div>

    <hr>
  <% end %>
<% else %>
  <p>No extras. Add an ingredient using the form below.</p>
<% end %>